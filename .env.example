# NEAGOLD - variables de entorno
# Desarrollo: copiar a .env y ajustar. NUNCA subir .env real a Git.
# Producción: copiar a .env en el servidor, rellenar la sección Producción
# (los placeholders de desarrollo hacen fallar el arranque en NODE_ENV=production)
# y desplegar con: docker compose -f docker-compose.prod.yml up -d --build

# PostgreSQL (en producción el host es el nombre del servicio 'postgres')
DATABASE_URL="postgresql://neagold:neagold_dev_password@localhost:5432/neagold?schema=public"

# Seed (solo desarrollo/tests; en producción NO debe activarse)
SEED_DEMO="true"
SEED_ADMIN_EMAIL="admin@neagold.local"
# NOTA: cambiar en desarrollo/producción
SEED_ADMIN_PASSWORD="ChangeMe_Neagold_2026!"

# Backend (api)
NODE_ENV="development"
PORT="3000"
# Secreto para firmar el access token (JWT). Mínimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="dev-only-jwt-access-secret-cambiar-en-produccion"
JWT_ACCESS_TTL_SECONDS="900"
JWT_ISSUER="neagold"
JWT_AUDIENCE="neagold-web"
# Duración de la sesión (cookie de refresh) en días
SESSION_TTL_DAYS="30"
# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS="http://localhost:5173,http://localhost:4173"
# Tasa global de peticiones
THROTTLE_TTL_SECONDS="60"
THROTTLE_LIMIT="120"
# Límite por IP del endpoint de login (15/min en producción por defecto)
LOGIN_THROTTLE_LIMIT="15"
LOGIN_THROTTLE_TTL_MS="60000"
# URL pública del frontend (base de enlaces de email)
PUBLIC_BASE_URL="https://neagold.com"
# Clave AES-256-GCM (hex de 64 caracteres) para cifrar secretos TOTP en reposo.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_SECRET_ENCRYPTION_KEY="cambiar-por-hex-de-64-caracteres"
# Emisor que se muestra en la app de autenticación (otpauth://totp/<issuer>:<email>)
TOTP_ISSUER="NEAGOLD"
# Publicar el nombre del propietario actual en /verify (false por defecto en prod)
VERIFY_OWNER_NAME="false"
# Provider de email: si SMTP_HOST está definido se usa SMTP (nodemailer);
# si no, provider de desarrollo (los enlaces se devuelven en la respuesta).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
# Entregas de webhooks (poll del worker y timeout por entrega en ms)
WEBHOOK_DELIVERY_TIMEOUT_MS="5000"
WEBHOOK_DELIVERY_POLL_MS="10000"

# Frontend (web) - origen de la API en producción (vacío = mismo origen, la
# SPA se sirve a través de nginx que proxya /api y /verify a la API)
# VITE_API_ORIGIN=""

# ---------------------- PRODUCCIÓN (obligatorio) ----------------------
# Con NODE_ENV=production el arranque FALLA si no se cumple todo esto:
#   - JWT_ACCESS_SECRET real (no puede empezar por 'dev-only-')
#   - MFA_SECRET_ENCRYPTION_KEY real (hex de 64 caracteres)
#   - CORS_ORIGINS con los orígenes reales de la SPA
#   - SMTP_HOST configurado (los emails no pueden ir al provider de desarrollo)
# NODE_ENV="production"
# DATABASE_URL="postgresql://neagold:TU_CONTRASEÑA@postgres:5432/neagold?schema=public"
# POSTGRES_USER="neagold"
# POSTGRES_PASSWORD="TU_CONTRASEÑA"
# POSTGRES_DB="neagold"
# CORS_ORIGINS="https://neagold.com"
# PUBLIC_BASE_URL="https://neagold.com"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="secret"
# EMAIL_FROM="NEAGOLD <no-reply@neagold.com>"
# VITE_API_ORIGIN=""